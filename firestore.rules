rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==================================================
       USERS
    ================================================== */

    match /users/{userId} {

      allow create: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['vendor', 'customer'];

      allow read: if
        request.auth != null
        && request.auth.uid == userId;

      allow update: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }


    /* ==================================================
       VENDOR PROFILE
       Public discovery information.

       NOTE:
       GPS MUST NOT be stored here in final architecture.
       ================================================== */

    match /vendorProfiles/{vendorId} {

      allow read: if
        request.auth != null;

      allow create, update: if
        request.auth != null
        && request.auth.uid == vendorId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'vendor';

      allow delete: if
        request.auth != null
        && request.auth.uid == vendorId;
    }


    /* ==================================================
       VENDOR LOCATIONS

       Customer can read ONLY when subscribed.
       Vendor can read/write own location.
       ================================================== */

    match /vendorLocations/{vendorId} {

      // Mitra dapat membaca dan menulis lokasi miliknya sendiri.
      // Konsumen hanya dapat membaca lokasi Mitra yang benar-benar
      // memiliki dokumen subscription aktif untuk konsumen tersebut.
      allow read: if
        request.auth != null
        && (
          request.auth.uid == vendorId
          ||
          (
            exists(
              /databases/$(database)/documents/subscriptions/$(request.auth.uid + '_' + vendorId)
            )
            &&
            get(
              /databases/$(database)/documents/subscriptions/$(request.auth.uid + '_' + vendorId)
            ).data.customerId == request.auth.uid
            &&
            get(
              /databases/$(database)/documents/subscriptions/$(request.auth.uid + '_' + vendorId)
            ).data.vendorId == vendorId
            &&
            get(
              /databases/$(database)/documents/subscriptions/$(request.auth.uid + '_' + vendorId)
            ).data.active == true
          )
        );

      allow create, update: if
        request.auth != null
        && request.auth.uid == vendorId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.vendorId == vendorId;

      allow delete: if
        request.auth != null
        && request.auth.uid == vendorId;
    }


    /* ==================================================
       SUBSCRIPTIONS

       Document ID:
        subscriptions/
  {customerUID}

    customerId: "..."
    vendors:
      vendorUID1: true
      vendorUID2: true
    ================================================== */

    match /subscriptions/{subscriptionId} {

      allow read: if
        request.auth != null
        && request.auth.uid ==
          resource.data.customerId;

      allow create: if
        request.auth != null
        && request.resource.data.customerId ==
          request.auth.uid
        && request.resource.data.vendorId is string
        && request.resource.data.active == true;

      allow update: if
        request.auth != null
        && request.auth.uid ==
          resource.data.customerId
        && request.resource.data.customerId ==
          resource.data.customerId
        && request.resource.data.vendorId ==
          resource.data.vendorId;

      allow delete: if
        request.auth != null
        && request.auth.uid ==
          resource.data.customerId;
    }


    /* ==================================================
       USERNAME RESERVATION
       ================================================== */

    match /usernames/{username} {

      allow read: if
        request.auth != null;

      allow create: if
        request.auth != null
        && request.resource.data.uid ==
          request.auth.uid
        && request.resource.data.username ==
          username;

      allow update: if
        request.auth != null
        && resource.data.uid ==
          request.auth.uid
        && request.resource.data.uid ==
          request.auth.uid
        && request.resource.data.username ==
          username;

      allow delete: if false;
    }


    /* ==================================================
       LEGACY VENDORS

       Kept temporarily so the current MVP does not
       suddenly break while migration to:

       vendorProfiles
       vendorLocations

       is being completed.
       ================================================== */

    match /vendors/{vendorId} {

      allow create, update: if
        request.auth != null
        && request.auth.uid == vendorId
        && request.resource.data.uid ==
          request.auth.uid
        && request.resource.data.role == 'vendor';

      allow read: if
        request.auth != null;

      allow delete: if
        request.auth != null
        && request.auth.uid == vendorId;
    }

    /* ==================================================
       VENDOR FCM PUSH TOKEN
       ================================================== */
    match /vendorPushTokens/{vendorId} {
      allow read: if
        request.auth != null
        && request.auth.uid == vendorId;

      allow create, update: if
        request.auth != null
        && request.auth.uid == vendorId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'vendor'
        && request.resource.data.token is string;

      allow delete: if
        request.auth != null
        && request.auth.uid == vendorId;
    }

    match /vendorMenus/{vendorId}/items/{itemId} {

  allow read: if
    request.auth != null;

  allow create: if
    request.auth != null
    && request.auth.uid == vendorId
    && request.resource.data.vendorId == request.auth.uid;

  allow update: if
    request.auth != null
    && request.auth.uid == vendorId
    && resource.data.vendorId == request.auth.uid
    && request.resource.data.vendorId == resource.data.vendorId;

  allow delete: if
    request.auth != null
    && request.auth.uid == vendorId;
}

    /* ==================================================
       DEFAULT DENY
       ================================================== */


    match /orders/{orderId} {

      // CUSTOMER:
      // Membuat order baru dengan status pending + COD.
      allow create: if
        request.auth != null
        && request.resource.data.customerId ==
          request.auth.uid
        && request.resource.data.vendorId is string
        && request.resource.data.status ==
          'pending'
        && request.resource.data.paymentMethod ==
          'cod';

      // CUSTOMER atau MITRA:
      // Hanya pihak yang terkait dengan order yang boleh membaca.
      allow read: if
        request.auth != null
        && (
          request.auth.uid ==
            resource.data.customerId
          ||
          request.auth.uid ==
            resource.data.vendorId
        );

      // MITRA:
      // Untuk MVP ini mitra hanya boleh mengubah
      // status dan updatedAt.
      //
      // Transisi yang diizinkan:
      // pending  -> accepted
      // pending  -> rejected
      // accepted -> completed
      allow update: if
        request.auth != null
        && request.auth.uid ==
          resource.data.vendorId
        && request.resource.data.customerId ==
          resource.data.customerId
        && request.resource.data.vendorId ==
          resource.data.vendorId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ])
        && request.resource.data.updatedAt is timestamp
        && (
          (
            resource.data.status ==
              'pending'
            &&
            request.resource.data.status in [
              'accepted',
              'rejected'
            ]
          )
          ||
          (
            resource.data.status ==
              'accepted'
            &&
            request.resource.data.status ==
              'completed'
          )
        );

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
